{
  "name": "universal-pos-desktop",
  "version": "2.0.0",
  "description": "Configurable offline desktop point-of-sale system",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable"
  },
  "author": "Abdullah Awais",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.abdullahawais850.posdesktop",
    "productName": "Universal POS",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "index.html", "styles.css", "renderer.js", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
